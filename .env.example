# ============================================================
# .env.example — Copy this to .env and fill in real values
# ============================================================
# cp .env.example .env
# ============================================================

# ── DATABASE ─────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_strong_password_here
DB_CHARSET=utf8mb4

# ── APPLICATION ──────────────────────────────────────────────
APP_NAME=FieldApp
APP_ENV=production

# ── SESSION ──────────────────────────────────────────────────
SESSION_LIFETIME=86400
MAX_MAIN_SESSIONS=3
MAX_SUB_SESSIONS=1
ADMIN_IDLE_TIMEOUT=900
OFFICE_ADMIN_IDLE_TIMEOUT=900
SUBADMIN_IDLE_TIMEOUT=900

# ── SECURITY ─────────────────────────────────────────────────
# Generate: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET_KEY=

# ── TIMEZONE ─────────────────────────────────────────────────
APP_TIMEZONE=Asia/Kolkata
DB_TIMEZONE_OFFSET=+05:30

# ── UPLOADS ──────────────────────────────────────────────────
UPLOAD_DIR=
UPLOAD_URL=

# ── ERROR REPORTING ──────────────────────────────────────────
DISPLAY_ERRORS=0
LOG_ERRORS=1
ERROR_LOG_PATH=/var/log/aandavar_error.log
